@Tutorial(time: 15) {
    @Intro(title: "08. SpriteKit face를 SceneKit 큐브에 붙이기") {
        이번 장에서는 SpriteKit에서 그린 퍼즐 화면을 SceneKit 큐브 한 면의 material로 붙입니다.

        아직 큐브를 회전하거나 stage를 넘기지 않습니다. 목표는 `SpriteKit scene -> SCNMaterial -> SCNBox` 연결을 보는 것입니다.
    }

    @Section(title: "SceneKit 화면 만들기") {
        @ContentAndMedia {
            SwiftUI는 `SpriteView`로 SpriteKit을 보여줬습니다. SceneKit은 `SCNView`로 3D scene을 보여줍니다.

            `UIViewRepresentable`은 SwiftUI 화면 안에 UIKit view인 `SCNView`를 넣기 위한 wrapper입니다.
        }

        @Steps {
            @Step {
                `SceneKitCubeView`를 만들고, SwiftUI에서 `SCNView`를 볼 수 있게 합니다.

                @Code(name: "SceneKitCubeView.swift", file: "08-SceneKitCubeView.swift")
            }
        }
    }

    @Section(title: "SpriteKit을 material로 쓰기") {
        @ContentAndMedia {
            SceneKit에서 큐브의 겉면은 `SCNMaterial`이 정합니다.

            `material.diffuse.contents`에 색을 넣으면 단색 면이 되고, SpriteKit scene을 넣으면 그 scene이 큐브 표면에 붙습니다. 이 연결 덕분에 2D로 그린 tile board를 3D 표면에서 볼 수 있습니다.
        }

        @Steps {
            @Step {
                `SCNBox`를 만들고, 한 면의 material contents에 SpriteKit scene을 넣습니다.

                @Code(name: "SceneKitPuzzleViewModel.swift", file: "08-CubeWithSpriteKitMaterial.swift")
            }
        }
    }

    @Section(title: "터치된 face 확인하기") {
        @ContentAndMedia {
            3D 화면에서는 사용자가 어느 면을 눌렀는지 먼저 알아야 합니다.

            `SCNView.hitTest`는 화면 좌표 아래에 있는 3D object를 찾습니다. 결과의 `geometryIndex`를 보면 큐브의 어느 material face가 터치됐는지 알 수 있습니다.
        }

        @Steps {
            @Step {
                아직 tile 선택으로 연결하지 않고, 터치한 cube face만 debug text로 확인합니다.

                @Code(name: "SceneKitPuzzleViewModel.swift", file: "08-HitTestFaceOnly.swift")
            }
        }
    }

    @Section(title: "실행 확인") {
        @ContentAndMedia {
            실행하면 SwiftUI 화면 안에 SceneKit 큐브가 보이고, 한 면에 SpriteKit 퍼즐 화면이 붙어 있어야 합니다.

            다음 장에서는 큐브에 붙일 퍼즐을 2x2에서 최종 학습용 3x3 cube net preview로 키웁니다.
        }

        @Steps {
            @Step {
                이번 장의 핵심 흐름을 말로 확인합니다. SpriteKit은 tile을 그리고, SceneKit은 큐브를 그리고, `SCNMaterial`이 둘을 연결합니다.
            }
        }
    }
}
