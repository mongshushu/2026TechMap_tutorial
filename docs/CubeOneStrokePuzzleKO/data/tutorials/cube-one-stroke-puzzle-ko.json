. 이 한붓그리기 프로젝트에서 이 board 위의 tile을 한 칸씩 이어서 선택하기 위해서는, 먼저 화면에서도 네 칸이 하나의 판처럼 맞닿아 있어야 합니다.","type":"text"}]},"doc://CubeOneStrokePuzzleKO/tutorials/CubeOneStrokePuzzleKO/10-Cube-Touch-To-One-Stroke":{"title":"10. 큐브 터치를 한붓그리기 선택으로 연결하기","type":"topic","url":"\/tutorials\/cubeonestrokepuzzleko\/10-cube-touch-to-one-stroke","role":"project","estimatedTime":"20min","kind":"project","abstract":[{"text":"9장에서 만든 ","type":"text"},{"type":"codeVoice","code":"TileID"},{"type":"text","text":"를 실제 퍼즐 선택으로 연결합니다."}],"identifier":"doc:\/\/CubeOneStrokePuzzleKO\/tutorials\/CubeOneStrokePuzzleKO\/10-Cube-Touch-To-One-Stroke"},"doc://CubeOneStrokePuzzleKO/tutorials/CubeOneStrokePuzzleKO/09-Cube-Touch-To-Tile-Name":{"abstract":[{"text":"이번 장에서는 SceneKit 큐브 표면을 탭했을 때, 그 탭이 SpriteKit board의 어느 tile에 해당하는지 계산합니다.","type":"text"}],"estimatedTime":"24min","title":"09. 큐브에서 누른 tile 이름 읽기","role":"project","identifier":"doc:\/\/CubeOneStrokePuzzleKO\/tutorials\/CubeOneStrokePuzzleKO\/09-Cube-Touch-To-Tile-Name","type":"topic","kind":"project","url":"\/tutorials\/cubeonestrokepuzzleko\/09-cube-touch-to-tile-name"},"chapter-foundation.svg":{"identifier":"chapter-foundation.svg","alt":"퍼즐 데이터 규칙을 나타내는 연결된 원.","variants":[{"traits":["1x","light"],"url":"\/images\/CubeOneStrokePuzzleKO\/chapter-foundation.svg"}],"type":"image"},"doc://CubeOneStrokePuzzleKO/tutorials/CubeOneStrokePuzzleKO/05-SwiftUI-StateObject-And-Scene-Connection":{"abstract":[{"type":"text","text":"이번 장에서는 게임이 기억해야 할 값을 "},{"code":"GameStore","type":"codeVoice"},{"type":"text","text":"로 분리합니다."}],"estimatedTime":"22min","title":"05. GameStore로 선택 상태 저장하기","role":"project","identifier":"doc:\/\/CubeOneStrokePuzzleKO\/tutorials\/CubeOneStrokePuzzleKO\/05-SwiftUI-StateObject-And-Scene-Connection","type":"topic","kind":"project","url":"\/tutorials\/cubeonestrokepuzzleko\/05-swiftui-stateobject-and-scene-connection"},"doc://CubeOneStrokePuzzleKO/tutorials/CubeOneStrokePuzzleKO/07-SceneKit-Cube-Material-And-Texture-Touch":{"abstract":[{"type":"text","text":"이번 장에서는 아무 tile이나 선택되는 상태를 막고, 현재 tile의 이웃 tile만 선택되게 만듭니다."}],"estimatedTime":"24min","title":"07. BoardModel과 이웃 규칙 추가하기","role":"project","identifier":"doc:\/\/CubeOneStrokePuzzleKO\/tutorials\/CubeOneStrokePuzzleKO\/07-SceneKit-Cube-Material-And-Texture-Touch","type":"topic","kind":"project","url":"\/tutorials\/cubeonestrokepuzzleko\/07-scenekit-cube-material-and-texture-touch"},"doc://CubeOneStrokePuzzleKO/tutorials/CubeOneStrokePuzzleKO/08-SceneKit-Rotation-Mode":{"url":"\/tutorials\/cubeonestrokepuzzleko\/08-scenekit-rotation-mode","type":"topic","identifier":"doc:\/\/CubeOneStrokePuzzleKO\/tutorials\/CubeOneStrokePuzzleKO\/08-SceneKit-Rotation-Mode","role":"project","estimatedTime":"38min","kind":"project","abstract":[{"text":"이번 장에서는 SpriteKit에서 그린 퍼즐 화면을 SceneKit 큐브 한 면의 material로 붙입니다.","type":"text"}],"title":"08. SpriteKit face를 SceneKit 큐브에 붙이기"},"chapter-spritekit.svg":{"type":"image","identifier":"chapter-spritekit.svg","alt":"SpriteKit 타일 네 개와 SpriteKit 텍스트.","variants":[{"traits":["1x","light"],"url":"\/images\/CubeOneStrokePuzzleKO\/chapter-spritekit.svg"}]}}}