:"SKTileMapNode"},{"type":"text","text":", "},{"code":"SKTileSet","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"SKTileGroup"},{"text":"을 사용해서 가장 작은 playable board인 2x2 화면을 만듭니다.","type":"text"}],"url":"\/tutorials\/cube-one-stroke-puzzle-ko\/02-spritekit-tiles-and-touch-names"},"doc://com.example.CubeOneStrokePuzzleKO/tutorials/Cube-One-Stroke-Puzzle-KO/06-SwiftUI-Undo-And-Three-By-Three#3x3-cube-stage-%EC%82%AC%EC%9A%A9%ED%95%98%EA%B8%B0":{"role":"pseudoSymbol","title":"3x3 cube stage 사용하기","identifier":"doc:\/\/com.example.CubeOneStrokePuzzleKO\/tutorials\/Cube-One-Stroke-Puzzle-KO\/06-SwiftUI-Undo-And-Three-By-Three#3x3-cube-stage-%EC%82%AC%EC%9A%A9%ED%95%98%EA%B8%B0","abstract":[{"text":"간단한 undo 동작을 추가하고, 큐브에서 플레이할 stage를 3x3 board로 맞춥니다.","type":"text"}],"type":"section","kind":"section","url":"\/tutorials\/cube-one-stroke-puzzle-ko\/06-swiftui-undo-and-three-by-three#3x3-cube-stage-%EC%82%AC%EC%9A%A9%ED%95%98%EA%B8%B0"},"doc://com.example.CubeOneStrokePuzzleKO/tutorials/Cube-One-Stroke-Puzzle-KO/08-SceneKit-Rotation-Mode#rotation-mode%EC%97%90%EC%84%9C%EB%A7%8C-%ED%9A%8C%EC%A0%84%ED%95%98%EA%B8%B0":{"role":"pseudoSymbol","kind":"section","title":"rotation mode에서만 회전하기","identifier":"doc:\/\/com.example.CubeOneStrokePuzzleKO\/tutorials\/Cube-One-Stroke-Puzzle-KO\/08-SceneKit-Rotation-Mode#rotation-mode%EC%97%90%EC%84%9C%EB%A7%8C-%ED%9A%8C%EC%A0%84%ED%95%98%EA%B8%B0","type":"section","abstract":[{"text":"puzzle tap과 cube rotation을 분리해서, 사용자가 path를 바꾸지 않고도 모서리와 맞닿은 다음 cube face를 확인할 수 있게 합니다.","type":"text"}],"url":"\/tutorials\/cube-one-stroke-puzzle-ko\/08-scenekit-rotation-mode#rotation-mode%EC%97%90%EC%84%9C%EB%A7%8C-%ED%9A%8C%EC%A0%84%ED%95%98%EA%B8%B0"},"07-EdgeTransition.swift":{"identifier":"07-EdgeTransition.swift","type":"file","fileName":"SceneKitPuzzleViewModel.swift","content":["private func currentStageSharesEdgeWithNextStage() -> Bool {","    if stageIndex + 1 >= stages.count {","        return false","    }","","    let currentStage = stages[stageIndex]","    let nextStage = stages[stageIndex + 1]","","    guard let exitEdge = currentStage.exitEdge,","          let entryEdge = nextStage.entryEdge,","          let lastTileID = pathTileIDs.last,","          let expectedStartTileID = matchingStartTileID(","            from: lastTileID,","            exitEdge: exitEdge,","            currentStage: currentStage,","            nextStage: nextStage,","            entryEdge: entryEdge","          ) else {","        return false","    }","","    return nextStage.startTileID == expectedStartTileID","}","","private func matchingStartTileID(","    from lastTileID: TileID,","    exitEdge: TileEdge,","    currentStage: BoardPlan,","    nextStage: BoardPlan,","    entryEdge: TileEdge",") -> TileID? {","    if currentStage.boardSize != nextStage.boardSize {","        return nil","    }","","    guard let position = lastTileID.position(","        on: exitEdge,","        boardSize: currentStage.boardSize","    ) else {","        return nil","    }","","    let nextPosition = currentStage.boardSize - 1 - position","","    if currentStage.cubeFace == .front &&","        exitEdge == .right &&","        nextStage.cubeFace == .right &&","        entryEdge == .left {","        return entryEdge.tileID(at: nextPosition, boardSize: nextStage.boardSize)","    }","","    if currentStage.cubeFace == .right &&","        exitEdge == .top &&","        nextStage.cubeFace == .top &&","        entryEdge == .right {","        return entryEdge.tileID(at: nextPosition, boardSize: nextStage.boardSize)","    }","","    return nil","}","","canAdvanceStage = isStageComplete && currentStageSharesEdgeWithNextStage()"],"fileType":"swift","highlights":[],"syntax":"swift"},"doc://com.example.CubeOneStrokePuzzleKO/tutorials/Cube-One-Stroke-Puzzle-KO/01-SpriteKit-Scene-And-Container-Layers":{"role":"project","kind":"project","title":"01. SpriteKit face scene 만들기","estimatedTime":"20min","type":"topic","identifier":"doc:\/\/com