odeVoice","code":"SKScene"},{"type":"text","text":" subclass and set "},{"type":"codeVoice","code":"scaleMode"},{"type":"text","text":" so the scene resizes with its container."}],"type":"paragraph"}],"caption":[]}],"anchor":"Create-the-scene-file"},{"contentSection":[{"kind":"contentAndMedia","mediaPosition":"trailing","content":[{"inlineContent":[{"type":"text","text":"Add separate layers before drawing tiles and labels. A layer is not a visible rectangle or text. It is an empty group that holds other nodes."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This scene is used as a cube-face texture, so it does not keep a title HUD inside the SpriteKit surface. The SwiftUI screen shows the title and status text outside the cube. The SpriteKit face keeps only puzzle tiles and coordinate labels."}],"type":"paragraph"}]}],"title":"Add render layers","stepsSection":[{"runtimePreview":null,"code":"01-RenderLayers.swift","media":"preview-placeholder.svg","type":"step","content":[{"inlineContent":[{"type":"text","text":"Add "},{"type":"codeVoice","code":"BoardRenderMode"},{"type":"text","text":" so the same scene can render active, completed, and future faces. Then add "},{"type":"codeVoice","code":"show(board:pathTileIDs:currentTileID:mode:)"},{"type":"text","text":". This method clears the previous drawing, creates "},{"type":"codeVoice","code":"tileLayer"},{"type":"text","text":" and "},{"type":"codeVoice","code":"labelLayer"},{"type":"text","text":", then calls the tile and label drawing helpers."}],"type":"paragraph"}],"caption":[]},{"runtimePreview":null,"code":null,"media":null,"type":"step","content":[{"inlineContent":[{"type":"text","text":"Read the call order carefully: clear old nodes, create layers, calculate board metrics, then draw tiles and labels. That order keeps each render pass predictable."}],"type":"paragraph"}],"caption":[]}],"anchor":"Add-render-layers"},{"contentSection":[{"kind":"contentAndMedia","media":"expected-01-spritekit-scene.svg","mediaPosition":"trailing","content":[{"inlineContent":[{"type":"text","text":"You should have a SpriteKit scene that can redraw one cube face from board data."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"zPosition"},{"text":" controls front-to-back order. A larger number appears in front of a smaller number.","type":"text"}],"type":"paragraph"}]}],"title":"Check the result","stepsSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep "},{"code":"tileLayer","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"labelLayer"},{"text":" in the file. They keep tile visuals and coordinate labels separate without adding extra architecture.","type":"text"}]}],"type":"step","media":null,"runtimePreview":null,"code":null,"caption":[]}],"anchor":"Check-the-result"}]},{"title":"02. Build a 2x2 Tile Map","kind":"callToAction","abstract":[{"type":"text","text":"Use SpriteKit’s "},{"type":"codeVoice","code":"SKTileMapNode"},{"type":"text","text":", "},{"type":"codeVoice","code":"SKTileSet"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"SKTileGroup"},{"text":" to build the smallest playable board: a 2x2 tile map.","type":"text"}],"featuredEyebrow":"Tutorial","action":{"type":"reference","isActive":true,"overridingTitle":"Get started","overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/02-SpriteKit-Tiles-And-Touch-Names"}}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/01-SpriteKit-Scene-And-Container-Layers"},"metadata":{"category":"Cube One-Stroke Puzzle","role":"project","title":"01. Build the SpriteKit Face Scene","categoryPathComponent":"CubeOneStrokePuzzle"},"kind":"project","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorial