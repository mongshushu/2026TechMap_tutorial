"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/06-SwiftUI-Undo-And-Three-By-Three","sections":[{"reference":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/06-SwiftUI-Undo-And-Three-By-Three#Undo-the-last-tile","kind":"task"},{"reference":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/06-SwiftUI-Undo-And-Three-By-Three#Use-3x3-cube-stages","kind":"task"},{"reference":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/06-SwiftUI-Undo-And-Three-By-Three#Check-the-result","kind":"task"}]}],"reference":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/CubeOneStrokePuzzle\/SwiftUI-Connection"},{"projects":[{"sections":[{"reference":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/07-SceneKit-Cube-Material-And-Texture-Touch#Create-the-cube-material","kind":"task"},{"reference":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/07-SceneKit-Cube-Material-And-Texture-Touch#Find-the-tapped-surface","kind":"task"},{"reference":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/07-SceneKit-Cube-Material-And-Texture-Touch#Convert-surface-position-to-TileID","kind":"task"},{"reference":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/07-SceneKit-Cube-Material-And-Texture-Touch#Advance-only-across-a-shared-edge","kind":"task"},{"reference":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/07-SceneKit-Cube-Material-And-Texture-Touch#Keep-the-scope-focused","kind":"task"}],"reference":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/07-SceneKit-Cube-Material-And-Texture-Touch"},{"reference":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/08-SceneKit-Rotation-Mode","sections":[{"reference":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/08-SceneKit-Rotation-Mode#Lock-puzzle-taps-during-rotation","kind":"task"},{"reference":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/08-SceneKit-Rotation-Mode#Rotate-only-in-rotation-mode","kind":"task"},{"reference":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/08-SceneKit-Rotation-Mode#Auto-rotate-to-the-next-face","kind":"task"}]}],"reference":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/CubeOneStrokePuzzle\/SceneKit-Cube"}]},"sections":[{"estimatedTimeInMinutes":30,"chapter":"SceneKit Cube","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Separate puzzle tapping from cube rotation so the player can inspect neighboring cube faces without changing the path."}]},{"type":"paragraph","inlineContent":[{"text":"Language: ","type":"text"},{"type":"reference","isActive":true,"identifier":"\/2026TechMap_tutorial\/CubeOneStrokePuzzleKO\/tutorials\/cube-one-stroke-puzzle-ko\/08-scenekit-rotation-mode\/"},{"text":".","type":"text"}]}],"title":"08. Handle Rotation Mode","kind":"hero"},{"tasks":[{"stepsSection":[{"media":"preview-placeholder.svg","code":"08-RotationTapGuard.swift","runtimePreview":null,"type":"step","content":[{"inlineContent":[{"text":"Add an early return to the tap handler, and update the debug text so the player understands why the tap did not select a tile.","type":"text"}],"type":"paragraph"}],"caption":[]}],"anchor":"Lock-puzzle-taps-during-rotation","title":"Lock puzzle taps during rotation","contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tapping and dragging both begin with touch input. If puzzle selection and cube rotation are active at the same time, the player can accidentally change the path while trying to rotate the cube."}]},{"type":"paragraph","inlineContent":[{"text":"Use a toggle-style rotation mode. When it is on, tile selection returns early.","type":"text"}]}]}]},{"stepsSection":[{"type":"step","runtimePreview":null,"caption":[],"media":"preview-placeholder.svg","content":[{"inlineContent":[{"type":"text","text":"Add the rotation mode setter and SwiftUI toggle. This is the code that scales the cube down while rotation mode is active."}],"type":"paragraph"}],"code":"08-RotationModeGuard.swift"},{"type":"step","runtimePreview":null,"caption":[],"media":"preview-placeholder.svg","content":[{"type":"paragraph","inlineContent":[{"text":"Guard the pan handler so it does nothing while rotation mode is off, then rotate the cube from the drag translation.","type":"text"}]}],"code":"08-RotationPan.swift"},{"code":null,"runtimePreview":null,"caption":[],"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Turn rotation mode off and confirm that taps select tiles again."}]}],"type":"step","media":null}],"title":"Rotate only in rotation mode","contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pan gestures should rotate the cube only while rotation mode is active."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When rotation mode is active, the cube also scales down slightly so the user gets a visible mode change."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In this project, rotation mode is not just for inspecting the cube. After completing the current face, the player uses it to find the next stage on a neighboring face. When rotation mode is off, taps update the puzzle path. When it is on, tile selection is locked."}]}],"media":"expected-08-rotation-mode.svg","mediaPosition":"trailing","kind":"contentAndMedia"}],"anchor":"Rotate-only-in-rotation-mode"},{"anchor":"Auto-rotate-to-the-next-face","stepsSection":[{"caption":[],"type":"step","runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a helper that maps each "},{"type":"codeVoice","code":"CubeFace"},{"type":"text","text":" to a display angle, then rotates the cube to that angle. In the same code, update "},{"type":"codeVoice","code":"goToNextStage()"},{"type":"text","text":" so it calls "},{"type":"codeVoice","code":"rotateCube(to: currentBoard.cubeFace)"},{"text":" after ","type":"text"},{"code":"loadStage(at:)","type":"codeVoice"},{"text":".","type":"text"}]}],"code":"08-AutoRotateToFace.swift","media":"preview-placeholder.svg"},{"code":null,"caption":[],"media":null,"runtimePreview":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"code":"usesShortestUnitArc: true","type":"codeVoice"},{"type":"text","text":" asks SceneKit to use a direct path from the current orientation to the target orientation. You do not need to memorize it yet; for now, remember it as the option that helps the cube avoid taking a long way around."}]}]}],"title":"Auto-rotate to the next face","contentSection":[{"content":[{"inlineContent":[{"type":"text","text":"When the app moves to the next stage, the puzzle data already points to a different "},{"type":"codeVoice","code":"cubeFace"},{"type":"text","text":". Now rotate the cube so that face comes into view."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"SCNAction.rotateTo"},{"text":" here. ","type":"text"},{"type":"codeVoice","code":"rotateTo"},{"text":" does not add more rotation to the current angle. It sends the node toward a final absolute angle.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"rotateBy"},{"type":"text","text":" adds a relative rotation from wherever the cube is now. If the player has already turned the cube in rotation mode, relative rotation can accumulate and leave the displayed face out of sync with the stage. Because each stage has a fixed target face, "},{"type":"codeVoice","code":"rotateTo"},{"type":"text","text":" is simpler."}],"type":"paragraph"}],"kind":"contentAndMedia","mediaPosition":"trailing"}]}],"kind":"tasks"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/08-SceneKit-Rotation-Mode"},"metadata":{"role":"project","category":"Cube One-Stroke Puzzle","categoryPathComponent":"CubeOneStrokePuzzle","title":"08. Handle Rotation Mode"},"kind":"project","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/cube-one-stroke-puzzle\/08-scenekit-rotation-mode"]}],"references":{"08-AutoRotateToFace.swift":{"content":["private func displayAngle(for face: CubeFace) -> SCNVector3 {","    if face == .front {","        return SCNVector3(x: -0.24, y: -0.34, z: 0)","    }","","    if face == .right {","        return SCNVector3(x: -0.24, y: -.pi \/ 2, z: 0)","    }","","    if face == .top {","        return SCNVector3(x: .pi \/ 2, y: -0.34, z: 0)","    }","","    return SCNVector3(x: -0.24, y: -0.34, z: 0)","}","","private func rotateCube(to face: CubeFace) {","    let angle = displayAngle(for: face)","    let action = SCNAction.rotateTo(","        x: CGFloat(angle.x),","        y: CGFloat(angle.y),","        z: CGFloat(angle.z),","        duration: 0.35,","        usesShortestUnitArc: true","    )","","    cubeNode.removeAction(forKey: \"stageTurn\")","    cubeNode.runAction(action, forKey: \"stageTurn\")","}","","func goToNextStage() {","    if canAdvanceStage == false {","        debugText = \"현재 퍼즐을 먼저 완료해야 다음으로 갈 수 있어요.\"","        return","    }","","    completedStageIndexes.insert(stageIndex)","    completedStagePaths[stageIndex] = pathTileIDs","    loadStage(at: stageIndex + 1)","    rotateCube(to: currentBoard.cubeFace)","}"],"syntax":"swift","identifier":"08-AutoRotateToFace.swift","fileName":"SceneKitPuzzleViewModel.swift","fileType":"swift","highlights":[],"type":"file"},"doc://com.example.CubeOneStrokePuzzle/tutorials/Cube-One-Stroke-Puzzle/03-Foundation-Board-Model-And-TileID#Create-BoardPlan":{"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/03-Foundation-Board-Model-And-TileID#Create-BoardPlan","abstract":[{"type":"text","text":"Create data types that can describe both the first 2x2 board and the later 3x3 board independently from SpriteKit drawing code."}],"url":"\/tutorials\/cube-one-stroke-puzzle\/03-foundation-board-model-and-tileid#Create-BoardPlan","role":"pseudoSymbol","kind":"section","type":"section","title":"Create BoardPlan"},"doc://com.example.CubeOneStrokePuzzle/tutorials/Cube-One-Stroke-Puzzle/02-SpriteKit-Tiles-And-Touch-Names":{"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/02-SpriteKit-Tiles-And-Touch-Names","abstract":[{"text":"Use SpriteKit’s ","type":"text"},{"type":"codeVoice","code":"SKTileMapNode"},{"text":", ","type":"text"},{"code":"SKTileSet","type":"codeVoice"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"SKTileGroup"},{"text":" to build the smallest playable board: a 2x2 tile map.","type":"text"}],"estimatedTime":"20min","url":"\/tutorials\/cube-one-stroke-puzzle\/02-spritekit-tiles-and-touch-names","role":"project","kind":"project","type":"topic","title":"02. Build a 2x2 Tile Map"},"doc://com.example.CubeOneStrokePuzzle/tutorials/Cube-One-Stroke-Puzzle/01-SpriteKit-Scene-And-Container-Layers":{"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/01-SpriteKit-Scene-And-Container-Layers","abstract":[{"text":"Create the SpriteKit scene that will later become a texture on each SceneKit cube face.","type":"text"}],"estimatedTime":"20min","url":"\/tutorials\/cube-one-stroke-puzzle\/01-spritekit-scene-and-container-layers","role":"project","kind":"project","type":"topic","title":"01. Build the SpriteKit Face Scene"},"doc://com.example.CubeOneStrokePuzzle/tutorials/CubeOneStrokePuzzle/SceneKit-Cube":{"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/CubeOneStrokePuzzle\/SceneKit-Cube","abstract":[],"url":"\/tutorials\/cubeonestrokepuzzle\/scenekit-cube","ro