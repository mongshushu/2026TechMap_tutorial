 tileID = currentBoard.tileID(fromTextureCoordinate: textureCoordinate) else {","    debugText = \"터치 좌표를 타일로 바꾸지 못했어요.\"","    return","}","","selectTile(tileID, textureCoordinate: textureCoordinate)"],"syntax":"swift","identifier":"07-HitTest.swift","fileName":"SceneKitPuzzleViewModel.swift","fileType":"swift","highlights":[],"type":"file"},"expected-07-cube-touch.svg":{"type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/com.example.CubeOneStrokePuzzle\/expected-07-cube-touch.svg"}],"identifier":"expected-07-cube-touch.svg","alt":"A cube surface touch converted into a 2D tile coordinate."},"doc://com.example.CubeOneStrokePuzzle/tutorials/CubeOneStrokePuzzle/Puzzle-Logic":{"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/CubeOneStrokePuzzle\/Puzzle-Logic","abstract":[],"url":"\/tutorials\/cubeonestrokepuzzle\/puzzle-logic","role":"article","kind":"article","type":"topic","title":"Puzzle Logic"},"doc://com.example.CubeOneStrokePuzzle/tutorials/Cube-One-Stroke-Puzzle/06-SwiftUI-Undo-And-Three-By-Three#Use-3x3-cube-stages":{"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/06-SwiftUI-Undo-And-Three-By-Three#Use-3x3-cube-stages","abstract":[{"type":"text","text":"Add a simple undo action, then move the playable cube stages to 3x3 boards."}],"url":"\/tutorials\/cube-one-stroke-puzzle\/06-swiftui-undo-and-three-by-three#Use-3x3-cube-stages","role":"pseudoSymbol","kind":"section","type":"section","title":"Use 3x3 cube stages"},"doc://com.example.CubeOneStrokePuzzle/tutorials/CubeOneStrokePuzzle":{"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/CubeOneStrokePuzzle","abstract":[{"text":"Connect SwiftUI, SpriteKit, and SceneKit to place one-stroke puzzle stages on multiple cube faces, learning the tile map structure with 2x2 first and using 3x3 boards for the cube version.","type":"text"}],"url":"\/tutorials\/cubeonestrokepuzzle","role":"overview","kind":"overview","type":"topic","tit