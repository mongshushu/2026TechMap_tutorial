ind":"task","reference":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/08-SceneKit-Rotation-Mode#Lock-puzzle-taps-during-rotation"},{"kind":"task","reference":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/08-SceneKit-Rotation-Mode#Rotate-only-in-rotation-mode"},{"kind":"task","reference":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/08-SceneKit-Rotation-Mode#Auto-rotate-to-the-next-face"}]}]}]},"sections":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Put SpriteKit puzzle scenes on multiple faces of an ","type":"text"},{"code":"SCNBox","type":"codeVoice"},{"text":", then convert a 3D surface tap into the current stage’s 2D tile coordinate.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Language: ","type":"text"},{"isActive":true,"identifier":"\/2026TechMap_tutorial\/CubeOneStrokePuzzleKO\/tutorials\/cube-one-stroke-puzzle-ko\/07-scenekit-cube-material-and-texture-touch\/","type":"reference"},{"text":".","type":"text"}]}],"chapter":"SceneKit Cube","estimatedTimeInMinutes":35,"kind":"hero","title":"07. Put SpriteKit on a SceneKit Cube"},{"tasks":[{"anchor":"Create-the-cube-material","stepsSection":[{"code":"07-Material.swift","media":"preview-placeholder.svg","runtimePreview":null,"content":[{"inlineContent":[{"text":"Create one material per face whose contents are a SpriteKit scene, then put those face materials into the ","type":"text"},{"code":"SCNBox","type":"codeVoice"},{"text":" material array.","type":"text"}],"type":"paragraph"}],"caption":[],"type":"step"}],"contentSection":[{"kind":"contentAndMedia","content":[{"inlineContent":[{"text":"SceneKit draws the cube. SpriteKit draws the puzzle face.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The bridge between them is an ","type":"text"},{"code":"SCNMaterial","type":"codeVoice"},{"text":": set the material’s diffuse contents to a SpriteKit scene.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This version does not swap every stage onto one face. Each stage is attached to a different cube face. A completed face is not replaced with one flat ","type":"text"},{"code":".systemTeal","type":"codeVoice"},{"text":" material; it remains a tile map where every square tile is ","type":"text"},{"code":".systemTeal","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"mediaPosition":"trailing"}],"title":"Create the cube material"},{"anchor":"Find-the-tapped-surface","stepsSection":[{"content":[{"inlineContent":[{"text":"Run a hit test from the tap location.","type":"text"}],"type":"paragraph"}],"type":"step","code":"07-HitTest.swift","runtimePreview":null,"media":"preview-placeholder.svg","caption":[]},{"content":[{"inlineContent":[{"text":"In the same hit-test code, check that the hit result belongs to the cube and to the current stage’s cube face.","type":"text"}],"type":"paragraph"}],"type":"step","code":null,"runtimePreview":null,"media":null,"caption":[]}],"contentSection":[{"content":[{"inlineContent":[{"code":"SCNView.hitTest","type":"codeVoice"},{"text":" asks SceneKit which 3D object is under the user’s finger.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The result tells you which node and which material face was hit, so you can ignore taps on faces that do not belong to the current stage.","type":"text"}],"type":"paragraph"}],"kind":"contentAndMedia","mediaPosition":"trailing"}],"title":"Find the tapped surface"},{"anchor":"Convert-surface-position-to-TileID","stepsSection":[{"content":[{"inlineContent":[{"type":"text","text":"Convert the texture coordinate into "},{"code":"row","type":"codeVoice"},{"type":"text","text":" and "},{"code":"column","type":"codeVoice"},{"type":"text","text":" for the current board size."}],"type":"paragraph"}],"type":"step","code":"07-TextureCoordinateToTileID.swift","runtimePreview":null,"media":"preview-placeholder.svg","caption":[]},{"code":null,"media":null,"runtimePreview":null,"content":[{"inlineContent":[{"type":"text","text":"Read the final two lines of the hit-test code: they convert the texture coordinate into a "},{"code":"TileID","type":"codeVoice"},{"type":"text","text":", then send it into the same selection logic you already built."}],"type":"paragraph"}],"caption":[],"type":"step"}],"contentSection":[{"content":[{"inlineContent":[{"code":"textureCoordinates(withMappingChannel:)","type":"codeVoice"},{"text":" is the key technique. It converts the 3D surface hit into a 2D coordinate between ","type":"text"},{"code":"0","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"1","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Multiplying that coordinate by the current board’s ","type":"text"},{"code":"boardSize","type":"codeVoice"},{"text":" turns the surface position into a row and column. The same code works for the learning 2x2 board and for the final 3x3 cube faces.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If a face direction mirrors the texture, use ","type":"text"},{"code":"coordinateLayout","type":"codeVoice"},{"text":" to remap raw row and column values. Use ","type":"text"},{"code":"labelCorrection","type":"codeVoice"},{"text":" so the coordinate labels stay readable on the cube.","type":"text"}],"type":"paragraph"}],"kind":"contentAndMedia","mediaPosition":"trailing","media":"expected-07-cube-touch.svg"}],"title":"Convert surface position to TileID"},{"anchor":"Advance-only-across-a-shared-edge","stepsSection":[{"caption":[],"media":"preview-placeholder.svg","type":"step","code":"07-EdgeTransition.swift","content":[{"inlineContent":[{"type":"codeVoice","code":"TileEdge"},{"type":"text","text":", "},{"type":"codeVoice","code":"entryEdge"},{"type":"text","text":", and "},{"type":"codeVoice","code":"exitEdge"},{"type":"text","text":" were added to "},{"type":"codeVoice","code":"BoardPlan"},{"type":"text","text":" in the model step. Now also check whether the current stage’s final tile sits on "},{"type":"codeVoice","code":"exitEdge"},{"type":"text","text":" and the next stage’s starting tile sits on "},{"type":"codeVoice","code":"entryEdge"},{"type":"text","text":"."}],"type":"paragraph"}],"runtimePreview":null},{"caption":[],"media":null,"type":"step","code":null,"content":[{"inlineContent":[{"text":"Read the final assignment in the code: ","type":"text"},{"code":"canAdvanceStage","type":"codeVoice"},{"text":" turns on only when the puzzle is complete, the next stage shares the matching cube edge, and both tiles sit on their edges.","type":"text"}],"type":"paragraph"}],"runtimePreview":null}],"contentSection":[{"kind":"contentAndMedia","content":[{"inlineContent":[{"type":"text","text":"Each stage already has a "},{"code":"cubeFace","type":"codeVoice"},{"type":"text","text":". Add only the edge facts the transition needs: which edge the current stage exits from, which edge the next stage enters from, and whether the start and goal tiles sit on those edges."}],"type":"paragraph"},{"inlineContent":[{"text":"This version does not build the full cube topology. The playable path only needs two explicit links: ","type":"text"},{"code":"front.right -> right.left","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"right.top -> top.right","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"mediaPosition":"trailing"}],"title":"Advance only across a shared edge"},{"anchor":"Keep-the-scope-focused","stepsSection":[{"caption":[],"runtimePreview":null,"content":[{"inlineContent":[{"type":"text","text":"Keep full six-face topology as a later refactor. In this first playable tutorial, explicitly place only the few neighboring faces used by the stages."}],"type":"paragraph"}],"media":null,"code":null,"type":"step"}],"contentSection":[{"kind":"contentAndMedia","content":[{"inlineContent":[{"type":"text","text":"This version does not implement full folded cube topology for all six faces."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The first playable goal is narrower: start on the front face, leave completed faces as "},{"code":".systemTeal","type":"codeVoice"},{"type":"text","text":" tile maps, and place the next stage on a neighboring face that touches the previous goal edge."}],"type":"paragraph"}],"mediaPosition":"trailing"}],"title":"Keep the scope focused"}],"kind":"tasks"},{"featuredEyebrow":"Tutorial","kind":"callToAction","title":"08. Handle Rotation Mode","action":{"type":"reference","isActive":true,"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/08-SceneKit-Rotation-Mode","overridingTitle":"Get started","overridingTitleInlineContent":[{"text":"Get started","type":"text"}]},"abstract":[{"type":"text","text":"Separate puzzle tapping from cube rotation so the player can inspect neighboring cube faces without changing the path."}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/07-SceneKit-Cube-Material-And-Texture-Touch"},"metadata":{"category":"Cube One-Stroke Puzzle","categoryPathComponent":"CubeOneStrokePuzzle","role":"project","title":"07. Put SpriteKit on a SceneKit Cube"},"kind":"project","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/cube-one-stroke-puzzle\/07-scenekit-cube-material-and-texture-touch"]}],"references":{"doc://com.example.CubeOneStrokePuzzle/tutorials/Cube-One-Stroke-Puzzle/02-SpriteKit-Tiles-And-Touch-Names#Connect-the-idea-to-tileID":{"title":"Connect the idea to tileID","role":"pseudoSymbol","identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/02-SpriteKit-Tiles-And-Touch-Names#Connect-the-idea-to-tileID","type":"section","url":"\/tutorials\/cube-one-stroke-puzzle\/02-spritekit-tiles-and-touch-names#Connect-the-idea-to-tileID","kind":"section","abstract":[{"type":"text","text":"Use SpriteKit’s "},{"code":"SKTileMapNode","type":"codeVoice"},{"type":"text","text":", "},{"code":"SKTileSet","type":"codeVoice"},{"type":"text","text":", and "},{"code":"SKTileGroup","type":"codeVoice"},{"type":"text","text":" to build the smallest playable board: a 2x2 tile map."}]},"doc://com.example.CubeOneStrokePuzzle/tutorials/Cube-One-Stroke-Puzzle/04-Foundation-GameStore-And-Neighbor-Rule#Block-invalid-selection":{"title":"Block invalid selection","role":"pseudoSymbol","identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/04-Foundation-GameStore-And-Neighbor-Rule#Block-invalid-selection","type":"section","url":"\/tutorials\/cube-one-stroke-puzzle\/04-foundation-gamestore-and-neighbor-rule#Block-invalid-selection","kind":"section","abstract":[{"text":"Add the first one-stroke rule: from the current tile, the next tile must be one step away horizontally or vertically.","type":"text"}]},"doc://com.example.CubeOneStrokePuzzle/tutorials/Cube-One-Stroke-Puzzle/05-SwiftUI-StateObject-And-Scene-Connection#Check-the-result":{"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/05-SwiftUI-StateObject-And-Scene-Connection#Check-the-result","abstract":[{"type":"text","text":"Keep one shared view model alive in SwiftUI, then pass it into the SceneKit view."}],"url":"\/tutorials\/cube-one-stroke-puzzle\/05-swiftui-stateobject-and-scene-connection#Check-the-result","role":"pseudoSymbol","kind":"section","type":"section","title":"Check the result"},"doc://com.example.CubeOneStrokePuzzle/tutorials/CubeOneStrokePuzzle/SceneKit-Cube":{"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/CubeOneStrokePuzzle\/SceneKit-Cube","abstract":[],"url":"\/tutorials\/cubeonestrokepuzzle\/scenekit-cube","role":"article","kind":"article","type":"topic","title":"SceneKit Cube"},"doc://com.example.CubeOneStrokePuzzle/tutorials/Cube-One-Stroke-Puzzle/04-Foundation-GameStore-And-Neighbor-Rule":{"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/04-Foundation-GameStore-And-Neighbor-Rule","abstract":[{"type":"text","text":"Add the first one-stroke rule: from the current tile, the next tile must be one step away horizontally or vertically."}],"estimatedTime":"30min","url":"\/tutorials\/cube-one-stroke-puzzle\/04-foundation-gamestore-and-neighbor-rule","role":"project","kind":"project","type":"topic","title":"04. Add One-Stroke Rules"},"doc://com.example.CubeOneStrokePuzzle/tutorials/Cube-One-Stroke-Puzzle/01-SpriteKit-Scene-And-Container-Layers":{"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/01-SpriteKit-Scene-And-Container-Layers","abstract":[{"text":"Create the SpriteKit scene that will later become a texture on each SceneKit cube face.","type":"text"}],"estimatedTime":"20min","url":"\/tutorials\/cube-one-stroke-puzzle\/01-spritekit-scene-and-container-layers","role":"project","kind":"project","type":"topic","title":"01. Build the SpriteKit Face Scene"},"doc://com.example.CubeOneStrokePuzzle/tutorials/Cube-One-Stroke-Puzzle/08-SceneKit-Rotation-Mode#Lock-puzzle-taps-during-rotation":{"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/08-SceneKit-Rotation-Mode#Lock-puzzle-taps-during-rotation","abstract":[{"text":"Separate puzzle tapping from cube rotation so the player can inspect neighboring cube faces without changing the path.","type":"text"}],"url":"\/tutorials\/cube-one-stroke-puzzle\/08-scenekit-rotation-mode#Lock-puzzle-taps-during-rotation","role":"pseudoSymbol","kind":"section","type":"section","title":"Lock puzzle taps during rotation"},"07-EdgeTransition.swift":{"content":["private func currentStageSharesEdgeWithNextStage() -> Bool {","    if stageIndex + 1 >= stages.count {","        return false","    }","","    let currentStage = stages[stageIndex]","    let nextStage = stages[stageIndex + 1]","","    guard let exitEdge = currentStage.exitEdge,","          let entryEdge = nextStage.entryEdge,","          let lastTileID = pathTileIDs.last,","          let expectedStartTileID = matchingStartTileID(","            from: lastTileID,","            exitEdge: exitEdge,","            currentStage: currentStage,","            nextStage: nextStage,","            entryEdge: entryEdge","          ) else {","        return false","    }","","    return nextStage.startTileID == expectedStartTileID","}","","private func matchingStartTileID(","    from lastTileID: TileID,","    exitEdge: TileEdge,","    currentStage: BoardPlan,","    nextStage: BoardPlan,","    entryEdge: TileEdge",") -> TileID? {","    if currentStage.boardSize != nextStage.boardSize {","        return nil","    }","","    guard let position = lastTileID.position(","        on: exitEdge,","        boardSize: currentStage.boardSize","    ) else {","        return nil","    }","","    let nextPosition = currentStage.boardSize - 1 - position","","    if currentStage.cubeFace == .front &&","        exitEdge == .right &&","        nextStage.cubeFace == .right &&","        entryEdge == .left {","        return entryEdge.tileID(at: nextPosition, boardSize: nextStage.boardSize)","    }","","    if currentStage.cubeFace == .right &&","        exitEdge == .top &&","        nextStage.cubeFace == .top &&","        entryEdge == .right {","        return entryEdge.tileID(at: nextPosition, boardSize: nextStage.boardSize)","    }","","    return nil","}","","canAdvanceStage = isStageComplete && currentStageSharesEdgeWithNextStage()"],"syntax":"swift","fileName":"SceneKitPuzzleViewModel.swift","identifier":"07-EdgeTransition.swift","fileType":"swift","highlights":[],"type":"file"},"doc://com.example.CubeOneStrokePuzzle/tutorials/Cube-One-Stroke-Puzzle/06-SwiftUI-Undo-And-Three-By-Three#Check-the-result":{"title":"Check the result","role":"pseudoSymbol","identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/