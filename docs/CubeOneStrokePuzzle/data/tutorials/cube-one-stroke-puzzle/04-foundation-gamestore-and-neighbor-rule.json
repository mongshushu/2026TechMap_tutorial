{"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[{"kind":"hero","estimatedTimeInMinutes":30,"title":"04. Add One-Stroke Rules","chapter":"Puzzle Logic","content":[{"type":"paragraph","inlineContent":[{"text":"Add the first one-stroke rule: from the current tile, the next tile must be one step away horizontally or vertically.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Language: ","type":"text"},{"isActive":true,"type":"reference","identifier":"\/2026TechMap_tutorial\/CubeOneStrokePuzzleKO\/tutorials\/cube-one-stroke-puzzle-ko\/04-foundation-gamestore-and-neighbor-rule\/"},{"text":".","type":"text"}]}]},{"kind":"tasks","tasks":[{"contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The puzzle needs to know whether two tiles are next to each other.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isNeighbor(from:to:)"},{"text":" uses argument labels so the call reads like a sentence: ask whether the current tile can move to the next tile.","type":"text"}]}],"mediaPosition":"trailing","kind":"contentAndMedia"}],"title":"Add a neighbor check","stepsSection":[{"code":"04-NeighborRule.swift","caption":[],"media":"preview-placeholder.svg","runtimePreview":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"Add ","type":"text"},{"type":"codeVoice","code":"isNeighbor(from:to:)"},{"text":" to your board model code.","type":"text"}]}]},{"code":null,"caption":[],"media":null,"runtimePreview":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"Check the two allowed cases: one row apart with the same column, or one column apart with the same row.","type":"text"}]}]}],"anchor":"Add-a-neighbor-check"},{"stepsSection":[{"type":"step","code":"04-CanSelect.swift","content":[{"type":"paragraph","inlineContent":[{"text":"Add the playable-tile check, current-tile check, visited-tile check, neighbor check, path update, completion check, and render call in ","type":"text"},{"code":"selectTile","type":"codeVoice"},{"type":"text","text":"."}]}],"caption":[],"media":"preview-placeholder.svg","runtimePreview":null}],"anchor":"Block-invalid-selection","title":"Block invalid selection","contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"text":"When the user touches a tile, the game should not immediately accept it. First, the game checks whether the tile has already been visited and whether it is a neighbor.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This tutorial uses beginner-readable ","type":"text"},{"type":"codeVoice","code":"if"},{"type":"text","text":" statements first. If the same logic becomes repeated later, that is the right time to refactor."}]}],"mediaPosition":"trailing","kind":"contentAndMedia"}]},{"stepsSection":[{"caption":[],"runtimePreview":null,"content":[{"inlineContent":[{"type":"text","text":"Explain the flow in your own words before moving on: "},{"code":"tileID -> can select? -> update path","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"type":"step","media":null,"code":null}],"anchor":"Trace-the-information","title":"Trace the information","contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The information flow is: get ","type":"text"},{"type":"codeVoice","code":"tileID"},{"text":", ask whether it can be selected, then update the path if the answer is true.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This is the same structure you will reuse when the tile comes from a 3D cube surface touch.","type":"text"}]}],"kind":"contentAndMedia","mediaPosition":"trailing"}]}]},{"action":{"type":"reference","identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/05-SwiftUI-StateObject-And-Scene-Connection","isActive":true,"overridingTitle":"Get started","overridingTitleInlineContent":[{"type":"text","text":"Get started"}]},"abstract":[{"text":"Keep one shared view model ali