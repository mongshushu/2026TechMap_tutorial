e.CubeOneStrokePuzzle/tutorials/Cube-One-Stroke-Puzzle/07-SceneKit-Cube-Material-And-Texture-Touch":{"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/07-SceneKit-Cube-Material-And-Texture-Touch","abstract":[{"type":"text","text":"Put SpriteKit puzzle scenes on multiple faces of an "},{"code":"SCNBox","type":"codeVoice"},{"type":"text","text":", then convert a 3D surface tap into the current stage’s 2D tile coordinate."}],"estimatedTime":"35min","url":"\/tutorials\/cube-one-stroke-puzzle\/07-scenekit-cube-material-and-texture-touch","role":"project","kind":"project","type":"topic","title":"07. Put SpriteKit on a SceneKit Cube"},"doc://com.example.CubeOneStrokePuzzle/tutorials/Cube-One-Stroke-Puzzle/08-SceneKit-Rotation-Mode#Lock-puzzle-taps-during-rotation":{"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/08-SceneKit-Rotation-Mode#Lock-puzzle-taps-during-rotation","abstract":[{"text":"Separate puzzle tapping from cube rotation so the player can inspect neighboring cube faces without changing the path.","type":"text"}],"url":"\/tutorials\/cube-one-stroke-puzzle\/08-scenekit-rotation-mode#Lock-puzzle-taps-during-rotation","role":"pseudoSymbol","kind":"section","type":"section","title":"Lock puzzle taps during rotation"},"04-CanSelect.swift":{"content":["private func selectTile(_ tileID: TileID, textureCoordinate: CGPoint) {","    if isStageComplete {","        debugText = \"이 퍼즐은 완료했어요. 다음 버튼으로 넘어가세요.\"","        return","    }","","    let board = currentBoard","    let visitedTileIDs = Set(pathTileIDs)","","    if board.isPlayable(tileID) == false {","        debugText = \"\\(tileID.name)은 지나갈 수 없는 칸입니다.\"","        return","    }","","    if tileID == currentTileID {","        debugText = \"\\(tileID.name)은 이미 현재 칸입니다.\"","        return","    }","","if visitedTileIDs.contains(tileID) {","        debugText = \"\\(tileID.name)은 이미 지나온 칸입니다.\"","        return","}","","if board.isNeighbor(from: currentTileID, to: tileID) == false {","        debugText = \"\\(currentTileID.name)에서 \\(tileID.name)으로는 바로 이동할 수 없어요.\"","        return","}","","    currentTileID = tileID","    pathTileIDs.append(tileID)","","    if pathTileIDs.count == board.playableTileCount && tileID == board.goalTileID {","        isStageComplete = true","    }","","    renderBoards()","}"],"syntax":"swift","fileName":"SceneKitPuzzleViewModel.swift","identifier":"04-CanSelect.swift","fileType":"swift","highlights":[],"type":"file"},"doc://com.example.CubeOneStrokePuzzle/tutorials/Cube-One-Stroke-Puzzle/04-Foundation-GameStore-And-Neighbor-Rule":{"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/04-Foundation-GameStore-And-Neighbor-Rule","abstract":[{"type":"text","text":"Add the first one-stroke rule: from the current tile, the next tile must be one step away horizontally or vertically."}],"estimatedTime":"30min","url":"\/tutorials\/cube-one-stroke-puzzle\/04-foundation-gamestore-and-neighbor-rule","role":"project","kind":"project","type":"topic","title":"04. Add One-Stroke Rules"},"doc://com.example.CubeOneStrokePuzzle/tutorials/Cube-One-Stroke-Puzzle/03-Foundation-Board-Model-And-TileID#Create-BoardPlan":{"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/03-Foundation-Board-Model-And-TileID#Create-BoardPlan","abstract":[{"type":"text","text":"Create data types that can describe both the first 2x2 board and the later 3x3 board independently from SpriteKit drawing code."}],"url":"\/tutorials\/cube-one-stroke-puzzle\/03-foundation-board-model-and-tileid#Create-BoardPlan","role":"pseudoSymbol","kind":"section","type":"section","title":"Create BoardPlan"},"/2026TechMap_tutorial/CubeOneStrokePuzzleKO/tutorials/cube-one-stroke-puzzle-ko/04-foundation-gamestore-and-neighbor-rule/":{"titleInlineContent":[{"type":"text","text":"한국어"}],"type":"link","title":"한국어","url":"\/2026TechMap_tutorial\/CubeOneStrokePuzzle