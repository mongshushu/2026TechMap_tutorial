"section","title":"Pass it to SceneKit"},"doc://com.example.CubeOneStrokePuzzle/tutorials/Cube-One-Stroke-Puzzle/06-SwiftUI-Undo-And-Three-By-Three#Check-the-result":{"title":"Check the result","role":"pseudoSymbol","identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/06-SwiftUI-Undo-And-Three-By-Three#Check-the-result","type":"section","url":"\/tutorials\/cube-one-stroke-puzzle\/06-swiftui-undo-and-three-by-three#Check-the-result","kind":"section","abstract":[{"type":"text","text":"Add a simple undo action, then move the playable cube stages to 3x3 boards."}]},"05-SceneKitCubeView.swift":{"content":["import SceneKit","import SwiftUI","","struct SceneKitCubeView: UIViewRepresentable {","    @ObservedObject var viewModel: SceneKitPuzzleViewModel","","    func makeCoordinator() -> Coordinator {","        Coordinator(viewModel: viewModel)","    }","","    func makeUIView(context: Context) -> SCNView {","        let sceneView = SCNView()","","        sceneView.scene = viewModel.scene","        sceneView.backgroundColor = .clear","        sceneView.allowsCameraControl = false","        sceneView.autoenablesDefaultLighting = false","        sceneView.isPlaying = true","","        let tapGesture = UITapGestureRecognizer(","            target: context.coordinator,","            action: #selector(Coordinator.handleTap(_:))","        )","        sceneView.addGestureRecognizer(tapGesture)","","        let panGesture = UIPanGestureRecognizer(","            target: context.coordinator,","            action: #selector(Coordinator.handlePan(_:))","        )","        sceneView.addGestureRecognizer(panGesture)","","        return sceneView","    }","","    func updateUIView(_ sceneView: SCNView, context: Context) {","        sceneView.scene = viewModel.scene","        context.coordinator.viewModel = viewModel","    }","","    @MainActor","    final class Coordinator: NSObject {","        var viewModel: SceneKitPuzzleViewModel","","        init(viewModel: SceneKitPuzzleViewModel) {","            self.viewModel = viewModel","        }","","        @objc func handleTap(_ recognizer: UITapGestureRecognizer) {","            guard let sceneView = recognizer.view as? SCNView else {","                return","            }","","            let point = recognizer.location(in: sceneView)","            viewModel.handleTap(at: point, in: sceneView)","        }","","        @objc func handlePan(_ recognizer: UIPanGestureRecognizer) {","            let translation = recognizer.translation(in: recognizer.view)","","            viewModel.handlePan(translation: translation)","            recognizer.setTranslation(.zero, in: recognizer.view)","        }","    }","}"],"fileType":"swift","highlights":[],"identifier":"05-SceneKitCubeView.swift","type":"file","fileName":"SceneKitCubeView.swift","syntax":"swift"},"doc://com.example.CubeOneStrokePuzzle/tutorials/Cube-One-Stroke-Puzzle/06-SwiftUI-Undo-And-Three-By-Three":{"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/06-SwiftUI-Undo-And-Three-By-Three","abstract":[{"text":"Add a simple undo action, then move the playable cube stages to 3x3 boards.","type":"text"}],"estimatedTime":"30min","url":"\/tutorials\/cube-one-stroke-puzzle\/06-swiftui-undo-and-three-by-three","role":"project","kind":"project","type":"topic","title":"06. Add Undo and Expand Stages"},"doc://com.example.CubeOneStrokePuzzle/tutorials/Cube-One-Stroke-Puzzle/07-SceneKit-Cube-Material-And-Texture-Touch#Keep-the-scope-focused":{"title":"Keep the scope focused","role":"pseudoSymbol","identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/07-SceneKit-Cube-Material-And-Texture-Touch#Keep-the-scope-focused","type":"section","url":"\/tutorials\/cube-one-stroke-puzzle\/07-scenekit-cube-material-and-texture-touch#Keep-the-scope-focused","kind":"section","abstract":[{"type":"text","text":"Put SpriteKit puzzle scenes on multiple faces of an "},{"type":"codeVoice","code":"SCNBox"},{"type":"text","text":", then convert a 3D surface tap into the current stage’s 2D tile coordinate."}]},"doc://com.example.CubeOneStrokePuzzle/tutorials/Cube-One-Stroke-Puzzle/05-SwiftUI-StateObject-And-Scene-Connection":{"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/05-SwiftUI-StateObject-And-Scene-Connection","abstract":[{"text":"Keep one shared view model alive in SwiftUI, then pass it into the SceneKit view.","type":"text"}],"estimatedTime":"25min","url":"\/tutorials\/cube-one-stroke-puzzle\/05-swiftui-stateobject-and-scene-connection","role":"project","kind":"project","type":"topic","title":"05. Connect SwiftUI State"}}}