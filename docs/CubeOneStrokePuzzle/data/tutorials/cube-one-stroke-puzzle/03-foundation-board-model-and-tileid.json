ference":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/08-SceneKit-Rotation-Mode#Lock-puzzle-taps-during-rotation","kind":"task"},{"reference":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/08-SceneKit-Rotation-Mode#Rotate-only-in-rotation-mode","kind":"task"},{"reference":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/08-SceneKit-Rotation-Mode#Auto-rotate-to-the-next-face","kind":"task"}]}]}]},"sections":[{"chapter":"Puzzle Logic","content":[{"type":"paragraph","inlineContent":[{"text":"Create data types that can describe both the first 2x2 board and the later 3x3 board independently from SpriteKit drawing code.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Language: ","type":"text"},{"isActive":true,"identifier":"\/2026TechMap_tutorial\/CubeOneStrokePuzzleKO\/tutorials\/cube-one-stroke-puzzle-ko\/03-foundation-board-model-and-tileid\/","type":"reference"},{"text":".","type":"text"}]}],"kind":"hero","title":"03. Model the Board","estimatedTimeInMinutes":25},{"kind":"tasks","tasks":[{"title":"Create TileID","stepsSection":[{"type":"step","code":"03-TileID.swift","content":[{"type":"paragraph","inlineContent":[{"text":"Create ","type":"text"},{"code":"PuzzleModels.swift","type":"codeVoice"},{"text":". Add ","type":"text"},{"code":"TileID","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"row","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"column"},{"text":", and a reusable ","type":"text"},{"type":"codeVoice","code":"name"},{"type":"text","text":". Add "},{"type":"codeVoice","code":"CubeFace"},{"text":" in the same code step because stages need to know which cube face owns the board.","type":"text"}]}],"caption":[],"media":"preview-placeholder.svg","runtimePreview":null},{"runtimePreview":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"Notice that ","type":"text"},{"code":"TileID","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":". This lets you put visited tiles into "},{"type":"codeVoice","code":"Set<TileID>"},{"text":".","type":"text"}]}],"caption":[],"media":null,"code":null}],"contentSection":[{"mediaPosition":"trailing","content":[{"type":"paragraph","inlineContent":[{"text":"A visible tile node is not enough for game logic. The game also needs a value that says which row and column the tile represents.","type":"text"}]},{"inlineContent":[{"type":"codeVoice","code":"TileID"},{"text":" is that value. It connects what you see on screen to the rules that decide whether a move is allowed.","type":"text"}],"type":"paragraph"}],"kind":"contentAndMedia"}],"anchor":"Create-TileID"},{"stepsSection":[{"type":"step","code":"03-BoardPlan.swift","runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add coordinate layout, label correction, tile edge, and "},{"code":"BoardPlan","type":"codeVoice"},{"text":" to the same file. These are the model facts later drawing and touch conversion code will read.","type":"text"}]}],"caption":[],"media":"preview-placeholder.svg"},{"type":"step","code":null,"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Read the stored properties and helpers out loud: title, board size, cube face, coordinate correction, start tile, goal tile, blocked tiles, playable count, bounds check, and playable check. Those are the minimum facts needed for the first playable board.","type":"text"}]}],"caption":[],"media":null}],"anchor":"Create-BoardPlan","title":"Create BoardPlan","contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"BoardPlan"},{"text":" stores the setup for one puzzle: where the player starts, where they should finish, and which tiles are blocked.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"boardSize","type":"codeVoice"},{"text":" tells the app how many cells wide and tall this board is. Start with ","type":"text"},{"code":"2","type":"codeVoice"},{"text":" for the 2x2 learning board, then use ","type":"text"},{"type":"codeVoice","code":"3"},{"text":" when the tutorial expands to 3x3.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"cubeFace","type":"codeVoice"},{"type":"text","text":" tells the app which cube face holds this stage. "},{"code":"coordinateLayout","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"labelCorrection"},{"text":" handle mirrored coordinates and labels after the SpriteKit scene becomes a cube-face texture.","type":"text"}]},{"inlineContent":[{"text":"Keep the model small at this stage. Do not add cube topology, multiple face rules, or advanced abstractions until the tutorial actually needs them.","type":"text"}],"type":"paragraph"}]}]},{"contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"At the end of this tutorial, SpriteKit still draws the tiles, but Foundation model types describe what those tiles mean and how large the current board is."}]}]}],"title":"Check the result","stepsSection":[{"runtimePreview":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep drawing code and board model code in separate files. The separation makes the next rule step easier to follow."}]}],"caption":[],"media":null,"code":null}],"anchor":"Check-the-result"}]},{"abstract":[{"text":"Add the first one-stroke rule: from the current tile, the next tile must be one step away horizontally or vertically.","type":"text"}],"kind":"callToAction","action":{"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/04-Foundation-GameStore-And-Neighbor-Rule","overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"type":"reference","overridingTitle":"Get started","isActive":true},"title":"04. Add One-Stroke Rules","featuredEyebrow":"Tutorial"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/03-Foundation-Board-Model-And-TileID"},"metadata":{"title":"03. Model the Board","role":"project","categoryPathComponent":"CubeOneStrokePuzzle","category":"Cube One-Stroke Puzzle"},"kind":"project","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/cube-one-stroke-puzzle\/03-foundation-board-model-and-tileid"]}],"references":{"doc://com.example.CubeOneStrokePuzzle/tutorials/Cube-One-Stroke-Puzzle/08-SceneKit-Rotation-Mode":{"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/08-SceneKit-Rotation-Mode","abstract":[{"type":"text","text":"Separate puzzle tapping from cube rotation so the player can inspect neighboring cube faces without changing the path."}],"estimatedTime":"30min","url":"\/tutorials\/cube-one-stroke-puzzle\/08-scenekit-rotation-mode","role":"project","kind":"project","type":"topic","title":"08. Handle Rotation Mode"},"doc://com.example.CubeOneStrokePuzzle/tutorials/Cube-One-Stroke-Puzzle/05-SwiftUI-StateObject-And-Scene-Connection#Pass-it-to-SceneKit":{"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/05-SwiftUI-StateObject-And-Scene-Connection#Pass-it-to-SceneKit","abstract":[{"type":"text","text":"Keep one shared view model alive in SwiftUI, then pass it into the SceneKit view."}],"url":"\/tutorials\/cube-one-stroke-puzzle\/05-swiftui-stateobject-and-scene-connection#Pass-it-to-SceneKit","role":"pseudoSymbol","kind":"section","type":"section","title":"Pass it to SceneKit"},"doc://com.example.CubeOneStrokePuzzle/tutorials/CubeOneStrokePuzzle/SceneKit-Cube":{"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/CubeOneStrokePuzzle\/SceneKit-Cube","abstract":[],"url":"\/tutorials\/cubeonestrokepuzzle\/scenekit-cube","role":"article","kind":"article","type":"topic","title":"SceneKit Cube"},"03-BoardPlan.swift":{"content":["import CoreGraphics","","enum TileCoordinateLayout {","    case standard","    case flipColumns","    case flipRows","    case rotateClockwise","    case rotateCounterClockwise","","    func tileID(forRawRow rawRow: Int, rawColumn: Int, boardSize: Int) -> TileID {","        switch self {","        case .standard:","            return TileID(row: rawRow, column: rawColumn)","        case .flipColumns:","            return TileID(row: rawRow, column: boardSize - 1 - rawColumn)","        case .flipRows:","            return TileID(row: boardSize - 1 - rawRow, column: rawColumn)","        case .rotateClockwise:","            return TileID(row: rawColumn, column: boardSize - 1 - rawRow)","        case .rotateCounterClockwise:","            return TileID(row: boardSize - 1 - rawColumn, column: rawRow)","        }","    }","}","","enum LabelCorrection {","    case normal","    case mirrorX","    case mirrorY","    case mirrorXY","","    var xScale: CGFloat {","        switch self {","        case .normal, .mirrorY:","            return 1","        case .mirrorX, .mirrorXY:","            return -1","        }","    }","","    var yScale: CGFloat {","        switch self {","        case .normal, .mirrorX:","            return 1","        case .mirrorY, .mirrorXY:","            return -1","        }","    }","}","","enum TileEdge {","    case top","    case right","    case bottom","    case left","","    func tileID(at position: Int, boardSize: Int) -> TileID? {","        if position < 0 || position >= boardSize {","            return nil","        }","","        if self == .top {","            return TileID(row: 0, column: position)","        } else if self == .right {","            return TileID(row: position, column: boardSize - 1)","        } else if self == .bottom {","            return TileID(row: boardSize - 1, column: position)","        } else {","            return TileID(row: position, column: 0)","        }","    }","}","","struct BoardPlan {","    let title: String","    let boardSize: Int","    let cubeFace: CubeFace","    let coordinateLayout: TileCoordinateLayout","    let labelCorrection: LabelCorrection","    let startTileID: TileID","    let goalTileID: TileID","    let entryEdge: TileEdge?","    let exitEdge: TileEdge?","    let blockedTileIDs: Set<TileID>","","    var playableTileCount: Int {","        var count = 0","","        for row in 0..<boardSize {","            for column in 0..<boardSize {","                let tileID = TileID(row: row, column: column)","","                if isPlayable(tileID) {","                    count += 1","                }","            }","        }","","        return count","    }","","    func contains(_ tileID: TileID) -> Bool {","        if tileID.row < 0 {","            return false","        }","","        if tileID.column < 0 {","            return false","        }","","        if tileID.row >= boardSize {","            return false","        }","","        if tileID.column >= boardSize {","            return false","        }","","        return true","    }","","    func isPlayable(_ tileID: TileID) -> Bool {","        if contains(tileID) == false {","            return false","        }","","        if blockedTileIDs.contains(tileID) {","            return false","        }","","        return true","    }","}"],"fileType":"swift","highlights":[],"identifier":"03-BoardPlan.swift","type":"file","fileName":"PuzzleModels.swift","syntax":"swift"},"preview-placeholder.svg":{"type":"image","identifier":"preview-placeholder.svg","variants":[{"traits":["1x","light"],"url":"\/images\/com.example.CubeOneStrokePuzzle\/preview-placeholder.svg"}],"alt":"Preview placeholder for the screen after adding this code."},"/2026TechMap_tutorial/CubeOneStrokePuzzleKO/tutorials/cube-one-stroke-puzzle-ko/03-foundation-board-model-and-tileid/":{"type":"link","identifier":"\/2026TechMap_tutorial\/CubeOneStrokePuzzleKO\/tutorials\/cube-one-stroke-puzzle-ko\/03-foundation-board-model-and-tileid\/","title":"한국어","titleInlineContent":[{"text":"한국어","type":"text"}],"url":"\/2026TechMap_tutorial\/CubeOneStrokePuzzleKO\/tutorials\/cube-one-stroke-puzzle-ko\/03-foundation-board-model-and-tileid\/"},"doc://com.example.CubeOneStrokePuzzle/tutorials/Cube-One-Stroke-Puzzle/06-SwiftUI-Undo-And-Three-By-Three#Use-3x3-cube-stages":{"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/06-SwiftUI-Undo-And-Three-By-Three#Use-3x3-cube-stages","abstract":[{"type":"text","text":"Add a simple undo action, then move the playable cube stages to 3x3 boards."}],"url":"\/tutorials\/cube-one-stroke-puzzle\/06-swiftui-undo-and-three-by-three#Use-3x3-cube-stages","role":"pseudoSymbol","kind":"section","type":"section","title":"Use 3x3 cube stages"},"doc://com.example.CubeOneStrokePuzzle/tutorials/CubeOneStrokePuzzle/SpriteKit-Foundations":{"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/CubeOneStrokePuzzle\/SpriteKit-Foundations","abstract":[],"url":"\/tutorials\/cubeonestrokepuzzle\/spritekit-foundations","role":"article","kind":"article","type":"topic","title":"SpriteKit Foundations"},"doc://com.example.CubeOneStrokePuzzle/tutorials/Cube-One-Stroke-Puzzle/08-SceneKit-Rotation-Mode#Rotate-only-in-rotation-mode":{"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/08-SceneKit-Rotation-Mode#Rotate-only-in-rotation-mode","abstract":[{"type":"text","text":"Separate puzzle tapping from cube rotation so the player can inspect neighboring cube faces without changing the path."}],"url":"\/tutorials\/cube-one-stroke-puzzle\/08-scenekit-rotation-mode#Rotate-only-in-rotation-mode","role":"pseudoSymbol","kind":"section","type":"section","title":"Rotate only in rotation mode"},"doc://com.example.CubeOneStrokePuzzle/tutorials/Cube-One-Stroke-P