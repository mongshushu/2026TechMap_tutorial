te data types that can describe both the first 2x2 board and the later 3x3 board independently from SpriteKit drawing code.","type":"text"}]},"doc://com.example.CubeOneStrokePuzzle/tutorials/Cube-One-Stroke-Puzzle/07-SceneKit-Cube-Material-And-Texture-Touch#Advance-only-across-a-shared-edge":{"title":"Advance only across a shared edge","role":"pseudoSymbol","identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/07-SceneKit-Cube-Material-And-Texture-Touch#Advance-only-across-a-shared-edge","type":"section","url":"\/tutorials\/cube-one-stroke-puzzle\/07-scenekit-cube-material-and-texture-touch#Advance-only-across-a-shared-edge","kind":"section","abstract":[{"text":"Put SpriteKit puzzle scenes on multiple faces of an ","type":"text"},{"code":"SCNBox","type":"codeVoice"},{"type":"text","text":", then convert a 3D surface tap into the current stage’s 2D tile coordinate."}]},"doc://com.example.CubeOneStrokePuzzle/tutorials/Cube-One-Stroke-Puzzle/04-Foundation-GameStore-And-Neighbor-Rule":{"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/04-Foundation-GameStore-And-Neighbor-Rule","abstract":[{"type":"text","text":"Add the first one-stroke rule: from the current tile, the next tile must be one step away horizontally or vertically."}],"estimatedTime":"30min","url":"\/tutorials\/cube-one-stroke-puzzle\/04-foundation-gamestore-and-neighbor-rule","role":"project","kind":"project","type":"topic","title":"04. Add One-Stroke Rules"},"doc://com.example.CubeOneStrokePuzzle/tutorials/Cube-One-Stroke-Puzzle/02-SpriteKit-Tiles-And-Touch-Names":{"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/02-SpriteKit-Tiles-And-Touch-Names","abstract":[{"text":"Use SpriteKit’s ","type":"text"},{"type":"codeVoice","code":"SKTileMapNode"},{"text":", ","type":"text"},{"code":"SKTileSet","type":"codeVoice"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"SKTileGroup"},{"text":" to build the smallest playable board: a 2x2 tile map.","type":"text"}],"estimatedTime":"20min","url":"\/tutorials\/cube-one-stroke-puzzle\/02-spritekit-tiles-and-touch-names","role":"project","kind":"project","type":"topic","title":"02. Build a 2x2 Tile Map"},"doc://com.example.CubeOneStrokePuzzle/tutorials/Cube-One-Stroke-Puzzle/05-SwiftUI-StateObject-And-Scene-Connection#Create-one-view-model":{"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/05-SwiftUI-StateObject-And-Scene-Connection#Create-one-view-model","abstract":[{"type":"text","text":"Keep one shared view model alive in SwiftUI, then pass it into the SceneKit view."}],"url":"\/tutorials\/cube-one-stroke-puzzle\/05-swiftui-stateobject-and-scene-connection#Create-one-view-model","role":"pseudoSymbol","kind":"section","type":"section","title":"Create one view model"},"doc://com.example.CubeOneStrokePuzzle/tutorials/Cube-One-Stroke-Puzzle/02-SpriteKit-Tiles-And-Touch-Names#Check-the-result":{"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/02-SpriteKit-Tiles-And-Touch-Names#Check-the-result","abstract":[{"text":"Use SpriteKit’s ","type":"text"},{"code":"SKTileMapNode","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SKTileSet","type":"codeVoice"},{"type":"text","text":", and "},{"code":"SKTileGroup","type":"codeVoice"},{"type":"text","text":" to build the smallest playable board: a 2x2 tile map."}],"url":"\/tutorials\/cube-one-stroke-puzzle\/02-spritekit-tiles-and-touch-names#Check-the-result","role":"pseudoSymbol","kind":"section","type":"section","title":"Check the result"},"doc://com.example.CubeOneStrokePuzzle/tutorials/Cube-One-Stroke-Puzzle/03-Foundation-Board-Model-And-TileID":{"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/03-Foundation-Board-Model-And-TileID","abstract":[{"type":"text","text":"Create data types that can describe both the first 2x2 board and the later 3x3 board independently from SpriteKit drawing code."}],"estimatedTime":"25min","url":"\/tutorials\/cube-one-stroke-puzzle\/03-foundation-board-model-and-tileid","role":"project","kind":"project","type":"topic","title":"03. Model the Board"},"02-TwoByTwoTileMap.swift":{"content":["private func boardMetrics(for board: BoardPlan) -> (tileSize: CGFloat, origin: CGPoint) {","    let shortSide = min(size.width, size.height)","    let boardSide = shortSide","    let tileSize = boardSide \/ CGFloat(board.boardSize)","    let originX = (size.width - boardSide) \/ 2","    let originY = (size.height - boardSide) \/ 2","","    return (","        tileSize: tileSize,","        origin: CGPoint(x: originX, y: originY)","    )","}","","private func drawTileMap(","    board: BoardPlan,","    visitedTileIDs: Set<TileID>,","    currentTileID: TileID?,","    mode: BoardRenderMode,","    in tileLayer: SKNode,","    tileSize: CGFloat,","    origin: CGPoint,","    tileGroups: TileGroups",") {","    let tileMap = SKTileMapNode(","        tileSet: tileGroups.tileSet,","        columns: board.boardSize,","        rows: board.boardSize,","        tileSize: CGSize(width: tileSize, height: tileSize)","    )","","    tileMap.name = \"puzzleTileMapNode\"","    tileMap.anchorPoint = CGPoint(x: 0, y: 0)","    tileMap.position = origin","    tileMap.enableAutomapping = false","","    for rawRow in 0..<board.boardSize {","        for rawColumn in 0..<board.boardSize {","            let tileID = board.tileID(forRawRow: rawRow, rawColumn: rawColumn)","            let tileGroup = tileGroup(","                for: tileID,","                board: board,","                visitedTileIDs: visitedTileIDs,","                currentTileID: currentTileID,","                mode: mode,","                tileGroups: tileGroups","            )","","            tileMap.setTileGroup(tileGroup, forColumn: rawColumn, row: rawRow)","        }","    }","","    tileLayer.addChild(tileMap)","}","","private func drawTileLabels(","    board: BoardPlan,","    in labelLayer: SKNode,","    tileSize: CGFloat,","    origin: CGPoint,","    currentTileID: TileID?,","    mode: BoardRenderMode",") {","    for rawRow in 0..<board.boardSize {","        for rawColumn in 0..<board.boardSize {","            let tileID = board.tileID(forRawRow: rawRow, rawColumn: rawColumn)","            let label = SKLabelNode(text: \"(\\(tileID.row),\\(tileID.column))\")","","            label.fontName = \"HelveticaNeue-Bold\"","            label.fontSize = tileSize * 0.13","            label.fontColor = labelColor(","                for: tileID,","                board: board,","                currentTileID: currentTileID,","                mode: mode","            )","            label.verticalAlignmentMode = .center","            label.horizontalAlignmentMode = .center","            label.position = tileCenter(","                rawRow: rawRow,","                rawColumn: rawColumn,","                tileSize: tileSize,","                origin: origin","            )","            label.xScale = board.labelCorrection.xScale","            label.yScale = board.labelCorrection.yScale","            label.zPosition = 1","            labelLayer.addChild(label)","        }","    }","}","","private func tileCenter(","    rawRow: Int,","    rawColumn: Int,","    tileSize: CGFloat,","    origin: CGPoint",") -> CGPoint {","    let x = origin.x + CGFloat(rawColumn) * tileSize + tileSize \/ 2","    let y = origin.y + CGFloat(rawRow) * tileSize + tileSize \/ 2","","    return CGPoint(x: x, y: y)","}","","private func tileGroup(","    for tileID: TileID,","    board: BoardPlan,","    visitedTileIDs: Set<TileID>,","    currentTileID: TileID?,","    mode: BoardRenderMode,","    tileGroups: TileGroups",") -> SKTileGroup {","    if mode == .completed {","        return tileGroups.completed","    }","","    if board.isPlayable(tileID) == false {","        return tileGroups.blocked","    }","","    if mode == .future {","        return tileGroups.empty","    }","","    if tileID == currentTileID {","        return tileGroups.current","    }","","    if visitedTileIDs.contains(tileID) {","        return tileGroups.visited","    }","","    return tileGroups.empty","}","","private func labelColor(","    for tileID: TileID,","    board: BoardPlan,","    currentTileID: TileID?,","    mode: BoardRenderMode",") -> UIColor {","    if mode == .completed {","        return .black","    }","","    if mode == .active && tileID == currentTileID {","        return .white","    }","","    if board.isPlayable(tileID) == false {","        return .darkGray","    }","","    return .black","}"],"syntax":"swift","identifier":"02-TwoByTwoTileMap.swift","fileName":"SpriteKitFaceScene.swift","fileType":"swift","highlights":[],"type":"file"},"doc://com.example.CubeOneStrokePuzzle/tutorials/Cube-One-Stroke-Puzzle/02-SpriteKit-Tiles-And-Touch-Names#Prepare-a-tile-palette":{"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/02-SpriteKit-Tiles-And-Touch-Names#Prepare-a-tile-palette","abstract":[{"type":"text","text":"Use SpriteKit’s "},{"code":"SKTileMapNode","type":"codeVoice"},{"type":"text","text":", "},{"code":"SKTileSet","type":"codeVoice"},{"type":"text","text":", and "},{"code":"SKTileGroup","type":"codeVoice"},{"type":"text","text":" to build the smallest playable board: a 2x2 tile map."}],"url":"\/tutorials\/cube-one-stroke-puzzle\/02-spritekit-tiles-and-touch-names#Prepare-a-tile-palette","role":"pseudoSymbol","kind":"section","type":"section","title":"Prepare a tile palette"},"doc://com.example.CubeOneStrokePuzzle/tutorials/Cube-One-Stroke-Puzzle/02-SpriteKit-Tiles-And-Touch-Names#Connect-the-idea-to-tileID":{"title":"Connect the idea to tileID","role":"pseudoSymbol","identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/02-SpriteKit-Tiles-And-Touch-Names#Connect-the-idea-to-tileID","type":"section","url":"\/tutorials\/cube-one-strok