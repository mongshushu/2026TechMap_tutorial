f an ","type":"text"},{"code":"SCNBox","type":"codeVoice"},{"text":", then convert a 3D surface tap into the current stage’s 2D tile coordinate.","type":"text"}]},"doc://com.example.CubeOneStrokePuzzle/tutorials/Cube-One-Stroke-Puzzle/06-SwiftUI-Undo-And-Three-By-Three#Check-the-result":{"title":"Check the result","role":"pseudoSymbol","identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/06-SwiftUI-Undo-And-Three-By-Three#Check-the-result","type":"section","url":"\/tutorials\/cube-one-stroke-puzzle\/06-swiftui-undo-and-three-by-three#Check-the-result","kind":"section","abstract":[{"type":"text","text":"Add a simple undo action, then move the playable cube stages to 3x3 boards."}]},"doc://com.example.CubeOneStrokePuzzle/tutorials/Cube-One-Stroke-Puzzle/06-SwiftUI-Undo-And-Three-By-Three#Use-3x3-cube-stages":{"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/06-SwiftUI-Undo-And-Three-By-Three#Use-3x3-cube-stages","abstract":[{"type":"text","text":"Add a simple undo action, then move the playable cube stages to 3x3 boards."}],"url":"\/tutorials\/cube-one-stroke-puzzle\/06-swiftui-undo-and-three-by-three#Use-3x3-cube-stages","role":"pseudoSymbol","kind":"section","type":"section","title":"Use 3x3 cube stages"},"doc://com.example.CubeOneStrokePuzzle/tutorials/CubeOneStrokePuzzle/Puzzle-Logic":{"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/CubeOneStrokePuzzle\/Puzzle-Logic","abstract":[],"url":"\/tutorials\/cubeonestrokepuzzle\/puzzle-logic","role":"article","kind":"article","type":"topic","title":"Puzzle Logic"},"02-TilePalette.swift":{"content":["private struct TileGroups {","    let empty: SKTileGroup","    let blocked: SKTileGroup","    let visited: SKTileGroup","    let current: SKTileGroup","    let completed: SKTileGroup","","    var tileSet: SKTileSet {","        SKTileSet(tileGroups: [","            empty,","            blocked,","            visited,","            current,","            completed","        ])","    }","}","","private func makeTileGroups(tileSize: CGFloat) -> TileGroups {","    TileGroups(","        empty: makeTileGroup(name: \"empty\", color: .white, tileSize: tileSize),","        blocked: makeTileGroup(name: \"blocked\", color: .systemGray2, tileSize: tileSize),","        visited: makeTileGroup(name: \"visited\", color: .systemTeal, tileSize: tileSize),","        current: makeTileGroup(name: \"current\", color: .blue, tileSize: tileSize),","        completed: makeTileGroup(name: \"completed\", color: .systemTeal, tileSize: tileSize)","    )","}","","private func makeTileGroup(name: String, color: UIColor, tileSize: CGFloat) -> SKTileGroup {","    let image = tileImage(color: color, tileSize: tileSize)","    let texture = SKTexture(image: image)","","    texture.filteringMode = .nearest","","    let definition = SKTileDefinition(texture: texture, size: image.size)","    let group = SKTileGroup(tileDefinition: definition)","","    group.name = name","","    return group","}","","private func tileImage(color: UIColor, tileSize: CGFloat) -> UIImage {","    let imageSize = CGSize(width: tileSize, height: tileSize)","    let renderer = UIGraphicsImageRenderer(size: imageSize)","","    return renderer.image { _ in","        let fillRect = CGRect(origin: .zero, size: imageSize)","        let borderRect = fillRect.insetBy(dx: 1.5, dy: 1.5)","        let path = UIBezierPath(rect: borderRect)","","        color.setFill()","        UIRectFill(fillRect)","","        UIColor.black.withAlphaComponent(0.72).setStroke()","        path.lineWidth = 3","        path.stroke()","    }","}"],"syntax":"swift","identifier":"02-TilePalette.swift","fileName":"SpriteKitFaceScene.swift","fileType":"swift","highlights":[],"type":"file"},"doc://com.example.CubeOneStrokePuzzle/tutorials/Cube-One-Stroke-Puzzle/08-SceneKit-Rotation-Mode#Auto-rotate-to-the-next-face":{"title":"Auto-rotate to the next face","role":"pseudoSymbol","identifier":"do