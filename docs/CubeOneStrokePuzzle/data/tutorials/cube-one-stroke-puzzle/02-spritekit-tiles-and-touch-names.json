xample.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/06-SwiftUI-Undo-And-Three-By-Three#Undo-the-last-tile","kind":"task"},{"reference":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/06-SwiftUI-Undo-And-Three-By-Three#Use-3x3-cube-stages","kind":"task"},{"reference":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/06-SwiftUI-Undo-And-Three-By-Three#Check-the-result","kind":"task"}]}]},{"reference":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/CubeOneStrokePuzzle\/SceneKit-Cube","projects":[{"reference":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/07-SceneKit-Cube-Material-And-Texture-Touch","sections":[{"reference":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/07-SceneKit-Cube-Material-And-Texture-Touch#Create-the-cube-material","kind":"task"},{"reference":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/07-SceneKit-Cube-Material-And-Texture-Touch#Find-the-tapped-surface","kind":"task"},{"reference":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/07-SceneKit-Cube-Material-And-Texture-Touch#Convert-surface-position-to-TileID","kind":"task"},{"kind":"task","reference":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/07-SceneKit-Cube-Material-And-Texture-Touch#Advance-only-across-a-shared-edge"},{"kind":"task","reference":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/07-SceneKit-Cube-Material-And-Texture-Touch#Keep-the-scope-focused"}]},{"reference":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/08-SceneKit-Rotation-Mode","sections":[{"reference":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/08-SceneKit-Rotation-Mode#Lock-puzzle-taps-during-rotation","kind":"task"},{"reference":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/08-SceneKit-Rotation-Mode#Rotate-only-in-rotation-mode","kind":"task"},{"reference":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/08-SceneKit-Rotation-Mode#Auto-rotate-to-the-next-face","kind":"task"}]}]}],"paths":[["doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/CubeOneStrokePuzzle","doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/CubeOneStrokePuzzle\/$volume","doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/CubeOneStrokePuzzle\/SpriteKit-Foundations"]]},"sections":[{"title":"02. Build a 2x2 Tile Map","content":[{"type":"paragraph","inlineContent":[{"text":"Use SpriteKit’s ","type":"text"},{"type":"codeVoice","code":"SKTileMapNode"},{"type":"text","text":", "},{"type":"codeVoice","code":"SKTileSet"},{"type":"text","text":", and "},{"type":"codeVoice","code":"SKTileGroup"},{"text":" to build the smallest playable board: a 2x2 tile map.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Language: ","type":"text"},{"identifier":"\/2026TechMap_tutorial\/CubeOneStrokePuzzleKO\/tutorials\/cube-one-stroke-puzzle-ko\/02-spritekit-tiles-and-touch-names\/","isActive":true,"type":"reference"},{"text":".","type":"text"}]}],"kind":"hero","chapter":"SpriteKit Foundations","estimatedTimeInMinutes":20},{"kind":"tasks","tasks":[{"anchor":"Prepare-a-tile-palette","stepsSection":[{"code":"02-TilePalette.swift","runtimePreview":null,"caption":[],"content":[{"inlineContent":[{"type":"text","text":"Create tile groups for empty, blocked, visited, current, and completed cells. Collect the tile groups in one "},{"code":"SKTileSet","type":"codeVoice"},{"text":", and add the helper that turns a filled ","type":"text"},{"code":"UIImage","type":"codeVoice"},{"text":" into an ","type":"text"},{"code":"SKTileGroup","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"type":"step","media":"preview-placeholder.svg"}],"title":"Prepare a tile palette","contentSection":[{"kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"type":"codeVoice","code":"SKTileGroup"},{"text":" describes how one kind of tile should look. For example, empty, visited, current, and completed tiles can each have a different tile group.","type":"text"}]},{"inlineContent":[{"type":"text","text":"This project keeps the color rule simple. The current tile is "},{"type":"codeVoice","code":".blue"},{"text":"; visited tiles and every tile on a completed face are ","type":"text"},{"type":"codeVoice","code":".systemTeal"},{"text":". A completed face is not replaced with one flat teal material; it stays a tile map with square cells and borders.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"type":"codeVoice","code":"SKTileSet"},{"type":"text","text":" collects those tile groups into a palette. After the palette exists, each cell in an "},{"code":"SKTileMapNode","type":"codeVoice"},{"type":"text","text":" can point to one tile group from that palette."}]}],"mediaPosition":"trailing"}]},{"contentSection":[{"mediaPosition":"trailing","content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SKTileMapNode"},{"text":" is a grid node. Instead of drawing each square as a separate ","type":"text"},{"type":"codeVoice","code":"SKShapeNode"},{"text":", the tile map owns the rows and columns.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This tutorial starts with 2x2 on purpose. Learn the SpriteKit tile map structure and the SceneKit surface-touch connection while the board is small, then expand the same structure to 3x3 later.","type":"text"}]},{"inlineContent":[{"text":"On the cube face, titles, status text, and path lines make the surface harder to read. The final SpriteKit texture keeps only square tiles and coordinate labels.","type":"text"}],"type":"paragraph"}],"kind":"contentAndMedia"}],"anchor":"Create-the-2x2-grid","stepsSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create the board metrics, tile map, tile label, tile role, and label color helpers. The "},{"type":"codeVoice","code":"SKTileMapNode"},{"type":"text","text":" uses "},{"code":"board.boardSize","type":"codeVoice"},{"type":"text","text":" for both columns and rows, then assigns one "},{"code":"SKTileGroup","type":"codeVoice"},{"text":" to each cell.","type":"text"}]}],"media":"preview-placeholder.svg","code":"02-TwoByTwoTileMap.swift","caption":[],"runtimePreview":null,"type":"step"},{"media":null,"code":null,"runtimePreview":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"Do not add a path line here. Selection state is shown by tile color instead of by connecting strokes, so the changed code is all inside ","type":"text"},{"code":"drawTileMap","type":"codeVoice"},{"text":".","type":"text"}]}],"caption":[]}],"title":"Create the 2x2 grid"},{"stepsSection":[{"caption":[],"type":"step","runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For now, check the visible tile map. The precise 3D touch conversion is connected in the SceneKit chapter."}]}],"code":null,"media":null}],"anchor":"Connect-the-idea-to-tileID","title":"Connect the idea to tileID","contentSection":[{"content":[{"inlineContent":[{"type":"text","text":"If every tile were a separate node, you could read "},{"code":"node.name","type":"codeVoice"},{"text":" to recover a name such as ","type":"text"},{"type":"codeVoice","code":"tile_0_0"},{"type":"text","text":". With "},{"type":"codeVoice","code":"SKTileMapNode"},{"type":"text","text":", the whole grid is one node, and each cell is identified by row and column instead."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This project uses "},{"type":"codeVoice","code":"TileID(row:column:)"},{"type":"text","text":" as the tile address. Later, when a SceneKit cube face is tapped, "},{"type":"codeVoice","code":"textureCoordinates"},{"type":"text","text":" gives a 2D position from "},{"type":"codeVoice","code":"0"},{"text":" to ","type":"text"},{"type":"codeVoice","code":"1"},{"text":", and that position becomes a ","type":"text"},{"type":"codeVoice","code":"TileID"},{"type":"text","text":" on the current 2x2 or 3x3 board."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a SpriteKit scene becomes a texture on a cube face, labels can appear mirrored or upside down depending on the face direction. Each stage therefore stores a "},{"type":"codeVoice","code":"coordinateLayout"},{"type":"text","text":" for touch-to-tile remapping and a "},{"type":"codeVoice","code":"labelCorrection"},{"type":"text","text":" for readable labels."}]}],"mediaPosition":"trailing","kind":"contentAndMedia"}]},{"stepsSection":[{"code":null,"runtimePreview":null,"type":"step","caption":[],"media":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Say the core relationship out loud: ","type":"text"},{"type":"codeVoice","code":"SKTileGroup"},{"text":" is a tile appearance, ","type":"text"},{"type":"codeVoice","code":"SKTileSet"},{"text":" is the palette, and ","type":"text"},{"code":"SKTileMapNode","type":"codeVoice"},{"text":" is the grid.","type":"text"}]}]}],"anchor":"Check-the-result","title":"Check the result","contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You should see a 2x2 SpriteKit tile map. The different colors are a learning aid so each tile role is visible."}]},{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"code":"SKTileMapNode","type":"codeVoice"},{"text":", row ","type":"text"},{"type":"codeVoice","code":"0"},{"text":" is the bottom row. The labels such as ","type":"text"},{"type":"codeVoice","code":"(0,0)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"(0,1)"},{"text":" preview the ","type":"text"},{"type":"codeVoice","code":"TileID"},{"text":" address each cell will use.","type":"text"}]}],"media":"expected-02-tilemap.svg","mediaPosition":"trailing","kind":"contentAndMedia"}]}]},{"action":{"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/03-Foundation-Board-Model-And-TileID","isActive":true,"overridingTitle":"Get started","type":"reference","overridingTitleInlineContent":[{"text":"Get started","type":"text"}]},"title":"03. Model the Board","abstract":[{"text":"Create data types that can describe both the first 2x2 board and the later 3x3 board independently from SpriteKit drawing code.","type":"text"}],"kind":"callToAction","featuredEyebrow":"Tutorial"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/02-SpriteKit-Tiles-And-Touch-Names"},"metadata":{"title":"02. Build a 2x2 Tile Map","role":"project","categoryPathComponent":"CubeOneStrokePuzzle","category":"Cube One-Stroke Puzzle"},"kind":"project","variants":[{"paths":["\/tutorials\/cube-one-stroke-puzzle\/02-spritekit-tiles-and-touch-names"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://com.example.CubeOneStrokePuzzle/tutorials/CubeOneStrokePuzzle/SceneKit-Cube":{"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/CubeOneStrokePuzzle\/SceneKit-Cube","abstract":[],"url":"\/tutorials\/cubeonestrokepuzzle\/scenekit-cube","role":"article","kind":"article","type":"topic","title":"SceneKit Cube"},"doc://com.example.CubeOneStrokePuzzle/tutorials/Cube-One-Stroke-Puzzle/08-SceneKit-Rotation-Mode#Rotate-only-in-rotation-mode":{"identifier":"doc:\/\/com.example.CubeOneStrokePuzzle\/tutorials\/Cube-One-Stroke-Puzzle\/08-SceneKit-Rotation-Mode#Rotate-only-in-rotation-mode","abstract":[{"type":"text","text":"Separate puzzle tapping from cube rotation so the player can inspect neighboring cube faces without changing the path."}],"url":"\/tutorials\/cube-one-stroke-puzzle\/08-scenekit-rotation-mode#Rotate-only-in-rotation-mode","role":"pseudoSymbol","kind